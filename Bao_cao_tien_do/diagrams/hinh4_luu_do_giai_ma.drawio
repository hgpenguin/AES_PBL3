<mxfile host="app.diagrams.net" modified="2026-11-07T03:42:00.000Z" agent="draw.io" version="24.0.0" type="device">
  <diagram id="decrypt-flow-w3" name="Luu do Giai ma Tuan 3">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="d1" value="Đầu vào: Tệp mã hóa (.enc) và Khóa K (16B) hoặc Mật khẩu (password)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontFamily=Times New Roman;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="175" y="30" width="470" height="45" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="8 byte đầu == &quot;AES3PWD\0&quot; ?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="280" y="105" width="260" height="65" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="Tách Salt (16B) và IV (16B)&#xa;Tái tạo K = PBKDF2-HMAC-SHA256(password, Salt)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="50" y="200" width="320" height="55" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="Tách IV (16B đầu tiên)&#xa;Sử dụng trực tiếp khóa K (16B)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="450" y="200" width="290" height="55" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="Tách bản mã CBC thành N khối 16 byte: C[0], C[1], ..., C[N-1]&#xa;Khởi tạo: prev ← IV; i ← 0" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="175" y="290" width="470" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d6" value="i &lt; N ?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="320" y="370" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d7" value="Giải mã lõi AES-128 (10 vòng nghịch đảo): Y ← decrypt_block(C[i])&#xa;Gỡ xích CBC: P[i] ← Y XOR prev&#xa;Cập nhật: prev ← C[i]; i ← i + 1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="175" y="460" width="470" height="65" as="geometry" />
        </mxCell>
        <mxCell id="d8" value="Kiểm tra và gỡ đệm PKCS#7: unpad(P[0] || ... || P[N-1]) hợp lệ?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="235" y="560" width="350" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d9" value="Ghi tệp khôi phục, tính SHA-256 và đối chiếu với SHA-256 gốc" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontFamily=Times New Roman;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="50" y="665" width="360" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d10" value="Phát sinh ngoại lệ ValueError&#xa;(Sai mật khẩu/khóa hoặc dữ liệu bị sửa đổi)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontFamily=Times New Roman;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
