<mxfile host="app.diagrams.net" modified="2026-11-07T03:42:00.000Z" agent="draw.io" version="24.0.0" type="device">
  <diagram id="encrypt-flow-w3" name="Luu do Ma hoa Tuan 3">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" value="Đầu vào: Tệp gốc (data) và Khóa K (16B) hoặc Mật khẩu (password)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontFamily=Times New Roman;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="180" y="30" width="460" height="45" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="Đọc dữ liệu nhị phân (rb) &amp; tính mã băm SHA-256 gốc" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="210" y="100" width="400" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Dùng mật khẩu?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="310" y="170" width="200" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Sinh Salt (16B) ngẫu nhiên&#xa;K = PBKDF2-HMAC-SHA256(password, Salt, 100.000)&#xa;Header = &quot;AES3PWD\0&quot; (8B) || Salt (16B)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="50" y="260" width="320" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="Sử dụng trực tiếp khóa K (16B)&#xa;Header = rỗng (0 byte)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="450" y="260" width="290" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="Đệm PKCS#7: pad(data) và chia thành N khối 16 byte: P[0], P[1], ..., P[N-1]&#xa;Khởi tạo: Sinh IV ngẫu nhiên (16B); prev ← IV; i ← 0" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="160" y="360" width="500" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="i &lt; N ?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="320" y="445" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="Trộn xích CBC: X ← P[i] XOR prev&#xa;Mã hóa lõi AES-128 (Ma trận 4×4, 10 vòng): C[i] ← encrypt_block(X)&#xa;Cập nhật: prev ← C[i]; i ← i + 1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="175" y="540" width="470" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="Đóng gói tệp mã hóa (.enc): Header || IV (16B) || C[0] || ... || C[N-1]&#xa;Trả về (IV, mã băm SHA-256 gốc)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontFamily=Times New Roman;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="175" y="645" width="470" height="50" as="geometry" />
